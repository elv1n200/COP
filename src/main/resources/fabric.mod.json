{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Hypixel Skyblock endgame mod for Fabric.",
  "authors": [
    "elvin"
  ],
  "contact": {
    "homepage": "https://github.com/elv1n200/COP",
    "sources": "https://github.com/elv1n200/COP",
    "issues": "https://github.com/elv1n200/COP/issues"
  },
  "icon": "assets/cop/icon.png",
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      {
        "adapter": "kotlin",
        "value": "cop.CopMod"
      }
    ]
  },
  "mixins": [
    "mixins.cop.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "=${minecraft_version}",
    "fabric-language-kotlin": ">=${fabric_kotlin_version}"
  }
}
