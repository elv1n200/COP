# --- Gradle ---------------------------------------------------------
.gradle/
build/
out/
bin/
!gradle/wrapper/gradle-wrapper.jar

# --- Stonecutter ----------------------------------------------------
# `versions/` is generated on the fly by `stonecutterGenerate`. The
# actual per-version source preprocessing output lives under
# `versions/<v>/build/` and gets recreated every build.
versions/

# --- IDE files ------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.code-workspace
.fleet/

# --- Loom dev environment ------------------------------------------
run/
runs/
remappedSrc/

# --- OS junk --------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- Output / artifacts --------------------------------------------
dist/
*.log
hs_err_pid*

# --- Local secrets / per-machine config -----------------------------
local.properties
.tmp_src/

# --- Editor / merge backups ----------------------------------------
*.bak
*.orig
*.rej
*.tmp
*.swp
*.swo
# Locally-renamed asset backups (e.g. icon.old.png) — explicit pattern
# so 'git add -A' doesn't accidentally commit them.
*.old.*

# --- Kotlin daemon cache -------------------------------------------
.kotlin/

# Claude Code worktrees + session metadata — local-only
.claude/
